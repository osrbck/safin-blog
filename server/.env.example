# MongoDB Atlas connection string (database name goes after the host, e.g. /safin)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/safin?retryWrites=true&w=majority

# Secret used to sign JSON Web Tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:3000

# Public address of the client (no trailing slash), used for sitemap.xml links. Defaults to the first CLIENT_URL.
SITE_URL=http://localhost:3000

PORT=5000
# Interface to bind. Use 127.0.0.1 behind a reverse proxy (Caddy/nginx) so the port is not reachable directly.
HOST=0.0.0.0
