# Leave these relative in development: Vite proxies /api, /uploads and /sitemap.xml to the API (see vite.config.js).
VITE_API_URL=/api
VITE_ASSETS_URL=

# Public address of the site, no trailing slash. Used for canonical / Open Graph URLs and robots.txt.
VITE_SITE_URL=http://localhost:3000

# Where the dev proxy forwards to
VITE_PROXY_TARGET=http://localhost:5000

# Production build (e.g. Vercel project settings → Environment Variables):
# VITE_API_URL=https://safin-api.osmansaribacak.online/api
# VITE_ASSETS_URL=https://safin-api.osmansaribacak.online
# VITE_SITE_URL=https://safin.osmansaribacak.online
